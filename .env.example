# REPAIRLINK Environment Configuration
# Target: Supabase & Next.js 15 App Router

# 1. Supabase Public Credentials (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Server-Only Secret Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Mapbox GL Access Token (For Phase 3 Provider Discovery Map)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSI...
